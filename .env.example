# ---------------------------------------------------------------------------
# Cybersecurity Club at GSU - environment configuration
# Copy this file to .env and fill in values. Never commit real secrets.
# Variables marked REQUIRED must be set for production. Everything else has a
# safe development default and is reported on the officer Configuration page.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Public URL of the site (no trailing slash). REQUIRED in production.
# Used for links inside emails, auth callbacks, sitemap and social previews.
APP_URL="http://localhost:3000"

# --- Database --------------------------------------------------------------
# Prisma connection string. REQUIRED.
# Local development default: SQLite file inside ./prisma
#   DATABASE_URL="file:./dev.db"
# Production (recommended): Postgres, e.g. Neon, Supabase, Railway or RDS.
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# When switching to Postgres, also set DATABASE_PROVIDER and follow README
# "Switching to Postgres" (the Prisma schema provider must match).
DATABASE_URL="file:./dev.db"
# "sqlite" (default) or "postgresql". Must match prisma/schema.prisma.
DATABASE_PROVIDER="sqlite"

# --- Authentication (Better Auth) --------------------------------------------
# Random 32+ character secret used to sign sessions and tokens. REQUIRED.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=""

# Comma-separated list of emails that receive the administrator role and
# approved membership automatically the first time they sign in. Use this to
# bootstrap the first officer account, then manage roles in /admin/members.
INITIAL_ADMIN_EMAILS=""

# --- Email delivery --------------------------------------------------------
# Emails are needed for account verification, password reset, email changes
# and GSU student verification codes.
# MAIL_MODE: "smtp" (real delivery) or "preview" (development only: messages
# are stored in the local database and shown at /dev/mailbox). Defaults to
# "preview" outside production and "smtp" in production.
MAIL_MODE="preview"
# Sender shown on outgoing mail.
MAIL_FROM="Cybersecurity Club at GSU <no-reply@example.edu>"
# SMTP settings (any provider: Gmail app password, Resend, Postmark, SES...)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# --- Discord (optional) ----------------------------------------------------
# Enables "Connect Discord" on the account page and real server-membership
# verification. Create an application at https://discord.com/developers and
# add the redirect URL: {APP_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# The club Discord server (guild) id, used to check whether a linked Discord
# account is actually a member of the server.
DISCORD_GUILD_ID=""
# Public invite link shown to visitors (from the PIN organization profile).
NEXT_PUBLIC_DISCORD_INVITE_URL="https://discord.gg/eMwQdmetKD"

# --- Media storage ---------------------------------------------------------
# MEDIA_STORAGE: "local" (files under MEDIA_LOCAL_DIR, fine for a single
# server) or "s3" (any S3-compatible bucket: AWS S3, Cloudflare R2, Supabase
# Storage S3 endpoint, MinIO). The bucket should stay PRIVATE; the app serves
# published images itself and enforces draft visibility.
MEDIA_STORAGE="local"
MEDIA_LOCAL_DIR="./storage/media"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Maximum accepted upload size in megabytes.
MEDIA_MAX_UPLOAD_MB="20"

# --- PIN (Campus Labs Engage) synchronisation --------------------------------
# Public RSS feed of the club's PIN organization. Officers can also trigger a
# sync manually from /admin/events. Set PIN_SYNC_ENABLED=false to maintain
# events manually only.
PIN_SYNC_ENABLED="true"
PIN_ORGANIZATION_KEY="cysecclub"
PIN_FEED_URL="https://pin.gsu.edu/organization/cysecclub/events.rss"
# Secret required by the scheduled sync endpoint (/api/pin/sync). Configure a
# cron job (e.g. Vercel Cron, GitHub Actions) to call it with
# Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=""

# --- Development preview switches --------------------------------------------
# When "true" (never in production) `npm run db:seed` can add clearly labelled
# sample records (marked isSample) for previewing layouts. They are excluded
# from production output.
ALLOW_SAMPLE_DATA="true"
