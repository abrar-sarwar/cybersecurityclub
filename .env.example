# ---------------------------------------------------------------------------
# Cybersecurity Club at GSU - environment configuration
# Copy this file to .env and fill in values. Never commit real secrets. .env and
# .env.* are gitignored; only this example is tracked.
# The site has no accounts for visitors. The values below are secret.
# ---------------------------------------------------------------------------

# Public URL of the site (no trailing slash). REQUIRED in production.
# Used for the sitemap, canonical links and social previews.
APP_URL="http://localhost:3000"

# Public invite link shown to visitors (from the PIN organization profile).
NEXT_PUBLIC_DISCORD_INVITE_URL="https://discord.gg/Mpb6FRj8s6"

# ---------------------------------------------------------------------------
# Events live in a Supabase project and are edited on /admin. These are
# secrets: set them in the host's environment, never in the client bundle.
# See docs/events-admin.md.
# ---------------------------------------------------------------------------
SUPABASE_URL="https://<project-ref>.supabase.co"
# A secret key for the project (service_role or sb_secret_...). Server only.
SUPABASE_SECRET_KEY=""
# How long the public page serves the same list before re-reading it, in seconds (default 300, minimum 30).
EVENTS_CACHE_SECONDS="300"

# Officer admin page at /admin (one shared login). Both required; keep secret.
# Changing the password signs every officer out.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
