# ---------------------------------------------------------------------------
# Cybersecurity Club at GSU - environment configuration
# Copy this file to .env (or run `npm run env:local`) and fill in values.
# Never commit real keys. .env and .env.* are gitignored; only this example is
# tracked. See README "Member portal" for where each value comes from.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Public URL of the site (no trailing slash). REQUIRED in production.
# Used for auth redirects, links inside emails, sitemap and social previews.
APP_URL="http://localhost:3000"

# Random secret (32+ characters) that signs unsubscribe links and keys
# rate-limit identifiers. REQUIRED in production. Generate one with:
#   openssl rand -base64 32
APP_SECRET=""

# --- Member portal: Supabase (auth + Postgres) ------------------------------
# Project URL and publishable key from Supabase > Project Settings > API Keys.
# The publishable key is safe in the browser: it only reaches what row level
# security allows. For local development, `supabase start` prints both.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Secret key (sb_secret_...). SERVER ONLY: it bypasses row level security.
# Never prefix it with NEXT_PUBLIC_, never import it into client components,
# and never paste it into issues or chat.
SUPABASE_SECRET_KEY=""

# Google OAuth client for LOCAL Supabase only (supabase/config.toml reads
# these). Hosted projects keep the Google client in the Supabase dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""

# --- Member portal: email (Resend) ------------------------------------------
# API key for student verification and event emails. SERVER ONLY.
# Without it, development prints emails to the server log; production refuses
# to send. Sign-in links are sent by Supabase Auth (configure its SMTP).
RESEND_API_KEY=""
# Sender on a domain verified in Resend.
EMAIL_FROM="Cybersecurity Club at GSU <no-reply@example.edu>"

# --- Public content database (Prisma) ----------------------------------------
# Public pages (PIN events, leadership, stories, media slots) still read from
# Prisma. Local development default: SQLite file inside ./prisma
#   DATABASE_URL="file:./dev.db"
# Production: Postgres, e.g. "postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
DATABASE_URL="file:./dev.db"
# "sqlite" (default) or "postgresql". Must match prisma/schema.prisma.
DATABASE_PROVIDER="sqlite"

# --- Discord ---------------------------------------------------------------
# Public invite link shown to visitors (from the PIN organization profile).
NEXT_PUBLIC_DISCORD_INVITE_URL="https://discord.gg/eMwQdmetKD"

# --- Media storage ---------------------------------------------------------
# MEDIA_STORAGE: "local" (files under MEDIA_LOCAL_DIR, fine for a single
# server) or "s3" (any S3-compatible bucket: AWS S3, Cloudflare R2, Supabase
# Storage S3 endpoint, MinIO). The bucket should stay PRIVATE; the app serves
# published images itself and enforces draft visibility.
MEDIA_STORAGE="local"
MEDIA_LOCAL_DIR="./storage/media"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Maximum accepted upload size in megabytes.
MEDIA_MAX_UPLOAD_MB="20"

# --- PIN (Campus Labs Engage) synchronisation --------------------------------
# Public RSS feed of the club's PIN organization. Officers can also trigger a
# sync manually from /admin/events. Set PIN_SYNC_ENABLED=false to maintain
# events manually only.
PIN_SYNC_ENABLED="true"
PIN_ORGANIZATION_KEY="cysecclub"
PIN_FEED_URL="https://pin.gsu.edu/organization/cysecclub/events.rss"
# Secret required by the scheduled sync endpoint (/api/pin/sync). Configure a
# cron job (e.g. Vercel Cron, GitHub Actions) to call it with
# Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=""

# --- Development preview switches --------------------------------------------
# When "true" (never in production) `npm run db:seed` can add clearly labelled
# sample records (marked isSample) for previewing layouts. They are excluded
# from production output.
ALLOW_SAMPLE_DATA="true"
