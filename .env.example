# ---------------------------------------------------------------------------
# Cybersecurity Club at GSU - environment configuration
# Copy this file to .env and fill in values. Never commit real secrets. .env and
# .env.* are gitignored; only this example is tracked.
# The site has no accounts, so no authentication or email keys are needed.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Public URL of the site (no trailing slash). REQUIRED in production.
# Used for the sitemap, canonical links and social previews.
APP_URL="http://localhost:3000"

# --- Public content database (Prisma) ----------------------------------------
# Public pages (PIN events, leadership, stories, media slots) read from Prisma.
# Local development default: SQLite file inside ./prisma
#   DATABASE_URL="file:./dev.db"
# Production: Postgres, e.g. "postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
DATABASE_URL="file:./dev.db"
# "sqlite" (default) or "postgresql". Must match prisma/schema.prisma.
DATABASE_PROVIDER="sqlite"

# --- Discord ---------------------------------------------------------------
# Public invite link shown to visitors (from the PIN organization profile).
NEXT_PUBLIC_DISCORD_INVITE_URL="https://discord.gg/Mpb6FRj8s6"

# --- PIN (Campus Labs Engage) ------------------------------------------------
# Public RSS feed of the club's PIN organization, for event synchronisation.
# Set PIN_SYNC_ENABLED=false to maintain events manually only.
PIN_SYNC_ENABLED="true"
PIN_ORGANIZATION_KEY="cysecclub"
PIN_FEED_URL="https://pin.gsu.edu/organization/cysecclub/events.rss"
# Secret for a scheduled sync endpoint, if one is added.
CRON_SECRET=""

# --- Development preview switches --------------------------------------------
# When "true" (never in production) seeded, clearly labelled sample records
# (marked isSample) can be shown for previewing layouts. They are excluded
# from production output.
ALLOW_SAMPLE_DATA="true"
