# ---------------------------------------------------------------------------
# Cybersecurity Club at GSU - environment configuration
# Copy this file to .env and fill in values. Never commit real secrets. .env and
# .env.* are gitignored; only this example is tracked.
# The site has no accounts and no database. The Google credentials below are secret.
# ---------------------------------------------------------------------------

# Public URL of the site (no trailing slash). REQUIRED in production.
# Used for the sitemap, canonical links and social previews.
APP_URL="http://localhost:3000"

# Public invite link shown to visitors (from the PIN organization profile).
NEXT_PUBLIC_DISCORD_INVITE_URL="https://discord.gg/Mpb6FRj8s6"

# ---------------------------------------------------------------------------
# Events come from a Google Sheet, read server-side with a read-only service
# account. See docs/events-google-sheet.md for setup. These are secrets:
# set them in the host's environment, never in the client bundle.
# ---------------------------------------------------------------------------
# The long ID in the sheet's URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=""
# The tab name (default "Events").
GOOGLE_SHEETS_RANGE="Events"
# From the service account's JSON key: "client_email" and "private_key".
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# How long the site serves the same sheet data before re-reading it, in seconds (default 300, minimum 30).
EVENTS_CACHE_SECONDS="300"

# Officer admin page at /admin (one shared login). Both required; keep secret.
# Changing the password signs every officer out. See docs/events-google-sheet.md.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
# Flyer uploads go to the Vercel Blob store connected to the project. On Vercel the
# connection provides BLOB_STORE_ID and short-lived credentials automatically; locally,
# run `vercel env pull .env.local` to get them.
